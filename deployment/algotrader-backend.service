[Unit]
Description=AlgoTrader Flask Backend (Gunicorn)
After=network.target mysql.service
Wants=mysql.service

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/var/www/algotrader/backend
EnvironmentFile=/var/www/algotrader/backend/.env
ExecStart=/var/www/algotrader/venv/bin/gunicorn \
    --workers 2 \
    --bind 127.0.0.1:5000 \
    --timeout 120 \
    --access-logfile /var/log/algotrader/access.log \
    --error-logfile  /var/log/algotrader/error.log \
    run:app
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=5
PrivateTmp=true
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
